# このファイルをコピーして .env.local を作成し、値を埋める
# cp env.sample .env.local

# LINE Messaging API（LINE Developers Console の Messaging API チャネルから取得）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LIFF（LINE Developers Console の LINEログインチャネル > LIFF タブから取得）
NEXT_PUBLIC_LIFF_ID=
# LIFF を置いた「LINEログインチャネル」の基本設定にある「チャネルID」（Messaging API チャネルではない）。
# LIFF の IDトークンの aud はこの値になるので、verify の client_id に使う
LINE_CHANNEL_ID=

# Supabase（Project Settings > API から取得）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー専用。NEXT_PUBLIC_ を付けない。クライアントに絶対渡さない
SUPABASE_SERVICE_ROLE_KEY=

# Google Maps（クライアントで使うキー。Google Cloud Console 側で HTTP リファラ制限を必ずかける）
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
